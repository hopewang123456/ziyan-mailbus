{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalToolsRegistry",
  "type": "object",
  "required": ["version", "tools"],
  "properties": {
    "version": { "type": "string" },
    "defaults": {
      "type": "object",
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "retry": { "type": "integer", "minimum": 0 }
      }
    },
    "providers": { "type": "object" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "kind", "description"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "enum": ["dify", "coze", "webhook"] },
          "kind": { "enum": ["workflow", "bot", "webhook"] },
          "workflow_id": { "type": "string" },
          "bot_id": { "type": "string" },
          "url_env": { "type": "string" },
          "secret_env": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
