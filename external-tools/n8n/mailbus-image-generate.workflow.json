{
  "name": "mailbus-image-generate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mailbus-image-generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8188/prompt",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body.comfy_prompt || $json.comfy_prompt }}",
        "options": {}
      },
      "id": "comfy",
      "name": "ComfyUI Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "ComfyUI Prompt", "type": "main", "index": 0 }]] },
    "ComfyUI Prompt": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "可选：mailbus webhook → ComfyUI。默认 mailbus 直连 lib/comfyui/client.py"
  }
}
