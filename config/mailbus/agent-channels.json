{
  "schema": "mailbus-agent-channels-v1",
  "defaults": {
    "hermes_profile": {
      "channels": {
        "a2a": { "enabled": true },
        "file_bus": { "enabled": true }
      },
      "endpoint": {
        "base_url": "https://mailbus.example/api/a2a/rpc/{agent_id}"
      }
    },
    "codex": {
      "channels": { "a2a": { "enabled": false }, "file_bus": { "enabled": true } },
      "transport": "local_cli"
    },
    "claude_code": {
      "channels": { "a2a": { "enabled": false }, "file_bus": { "enabled": true } },
      "transport": "local_cli"
    },
    "opencode": {
      "channels": { "a2a": { "enabled": false }, "file_bus": { "enabled": true } },
      "transport": "local_cli"
    },
    "openclaw": {
      "channels": { "a2a": { "enabled": false }, "file_bus": { "enabled": true } }
    }
  },
  "functional_group": {
    "agent-a": "product",
    "agent-d": "product",
    "agent-c": "security",
    "agent-j": "operations",
    "agent-e": "engineering",
    "agent-h": "engineering",
    "agent-g": "engineering",
    "agent-b": "engineering",
    "agent-i": "engineering",
    "agent-f": "ops",
    "agent-k": "operations",
    "agent-l": "operations",
    "agent-m": "execution"
  }
}
