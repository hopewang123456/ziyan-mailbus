# Mailbus env template — copy to mail/.env
# See migrate/env.template and migrate/README.md for full documentation
MAILBUS_ROOT=/path/to/mail
MAILBUS_DATA=/path/to/mail/store
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
OPENCLAW_WORKSPACE=/path/to/openclaw_space
OPENCODE_ROOT=/path/to/opencode
NODE_MODULES=/path/to/node_modules
# 典型 Windows：<LOCAL_ROOT>/mailbus-hermes/.hermes（与 mail 同盘；旧 <HERMES_DATA>/.hermes 已弃用）
HERMES_DATA=/path/to/mailbus-hermes/.hermes
TEAM_PACK_ROOT=/path/to/team-pack
CODEX_WORKSPACE=/path/to/codex

# ── Agent 原生配置所有权（默认不覆盖；仅排障时打开）────────────────
# RESET_OPENCLAW_PAIRING=1   # 清 OpenClaw devices/identity 后重配对
# FIX_OPENCLAW_PLUGINS=1     # fix-openclaw 才改 openclaw.json plugins
# FORCE_RENDER_CODEX_CONFIG=1  # 强制重写 ~/.codex/config.toml
RESET_OPENCLAW_PAIRING=0
FIX_OPENCLAW_PLUGINS=0
FORCE_RENDER_CODEX_CONFIG=0

# ── 知识库根（可选；未设置则用仓库内 junction 路径，SoT 在 Vault）────────
# 本机 Obsidian Vault 示例（迁移后结构）：
# MAILBUS_SKILLS_ROOT=<VAULT_ROOT>/Agent/01-mailbus/012-skills
# MAILBUS_RULES_ROOT=<VAULT_ROOT>/Agent/01-mailbus/011-rule
# MAILBUS_PLANS_ROOT=<VAULT_ROOT>/Agent/01-mailbus/017-plans
# MAILBUS_DOCS_ROOT=<VAULT_ROOT>/Agent/01-mailbus/016-docs
# MAILBUS_IDENTITIES_ROOT=<VAULT_ROOT>/Agent/01-mailbus/018-identities
# TEAM_PACK_SKILLS_ROOT=<VAULT_ROOT>/Agent/skills/team-pack
# TEAM_PACK_RULES_ROOT=<VAULT_ROOT>/Agent/rules/team-pack
# 技能共享组根（一级子目录=组）；默认仓库 skills/skillgroup/，本机 SoT 在 Vault 时指过去：
# MAILBUS_SKILLGROUP_ROOT=<VAULT_ROOT>/Agent/03-shared/skillgroup
MAILBUS_SKILLS_ROOT=
MAILBUS_RULES_ROOT=
MAILBUS_PLANS_ROOT=
MAILBUS_DOCS_ROOT=
MAILBUS_IDENTITIES_ROOT=
TEAM_PACK_SKILLS_ROOT=
TEAM_PACK_RULES_ROOT=
MAILBUS_SKILLGROUP_ROOT=
