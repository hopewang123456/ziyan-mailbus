# Mailbus env template — copy to mail/.env
# See migrate/env.template and migrate/README.md for full documentation
MAILBUS_ROOT=/path/to/mail
MAILBUS_DATA=/path/to/mail/store
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
OPENCLAW_WORKSPACE=/path/to/openclaw_space
OPENCODE_ROOT=/path/to/opencode
NODE_MODULES=/path/to/node_modules
# 典型 Windows：E:/hermes-data/.hermes（与 ai_tools 同级，非 ai_tools/hermes-data）
HERMES_DATA=/path/to/hermes-data/.hermes
TEAM_PACK_ROOT=/path/to/team-pack
LINGXIAO_WORKSPACE=/path/to/lingxiao

# ── Agent 原生配置所有权（默认不覆盖；仅排障时打开）────────────────
# RESET_OPENCLAW_PAIRING=1   # 清 OpenClaw devices/identity 后重配对
# FIX_OPENCLAW_PLUGINS=1     # fix-openclaw 才改 openclaw.json plugins
# FORCE_RENDER_CODEX_CONFIG=1  # 强制重写 ~/.codex/config.toml
RESET_OPENCLAW_PAIRING=0
FIX_OPENCLAW_PLUGINS=0
FORCE_RENDER_CODEX_CONFIG=0

# ── 知识库根（可选；未设置则用仓库内 demo 路径）────────────────────────
# 本机 Obsidian Vault 示例：
# MAILBUS_SKILLS_ROOT=E:/Obsidian/Vaults/Agent/skills/mailbus
# MAILBUS_RULES_ROOT=E:/Obsidian/Vaults/Agent/rules/mailbus
# MAILBUS_PLANS_ROOT=E:/Obsidian/Vaults/Agent/plans/mailbus
# MAILBUS_DOCS_ROOT=E:/Obsidian/Vaults/Agent/docs/mailbus
# MAILBUS_IDENTITIES_ROOT=E:/Obsidian/Vaults/Agent/identities/mailbus
# TEAM_PACK_SKILLS_ROOT=E:/Obsidian/Vaults/Agent/skills/team-pack
# TEAM_PACK_RULES_ROOT=E:/Obsidian/Vaults/Agent/rules/team-pack
MAILBUS_SKILLS_ROOT=
MAILBUS_RULES_ROOT=
MAILBUS_PLANS_ROOT=
MAILBUS_DOCS_ROOT=
MAILBUS_IDENTITIES_ROOT=
TEAM_PACK_SKILLS_ROOT=
TEAM_PACK_RULES_ROOT=
