# Mailbus env template — copy to mailbus/.env
# See migrate/env.template and migrate/README.md for full documentation
MAILBUS_ROOT=/path/to/mailbus
MAILBUS_DATA=/path/to/mailbus/store
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
# Compose 引擎看到的宿主根（写在 docker-agents/.env；override.yml 用 ${MAILBUS_HOST_ROOT}）
# MAILBUS_HOST_ROOT=/mnt/<drive>/path/to/mailbus

# 框架工作区：请在设置页或此处显式填写；留空则 doctor 提示未配置（不再猜兄弟仓路径）
OPENCLAW_WORKSPACE=
OPENCLAW_CONFIG=
# 可选：额外发现目录，分号分隔（如 D:/my-agents/openclaw_space）
MAILBUS_DISCOVERY_DIRS=
OPENCODE_ROOT=
NODE_MODULES=
HERMES_DATA=
TEAM_PACK_ROOT=/path/to/mailbus/team-pack
CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
CODEX_SKILLS=
DSH_WORKSPACE=
# Compose 未设时回落 docker-agents/workspaces/*（见该目录 README）

# ── Agent 原生配置所有权（默认不覆盖；仅排障时打开）────────────────
RESET_OPENCLAW_PAIRING=0
FIX_OPENCLAW_PLUGINS=0
FORCE_RENDER_CODEX_CONFIG=0

# ── 知识库根（可选）────────────────────────────────────────────────
# 未设置时默认使用仓库内 skills/ rules/ identities/（公开 example）。
# 自定义请优先走设置页「资产路径」写入 config；此处仅作逃生舱。
# MAILBUS_SKILLS_ROOT=/path/to/custom/skills
# MAILBUS_RULES_ROOT=/path/to/custom/rules
# MAILBUS_IDENTITIES_ROOT=/path/to/custom/identities
AGENT_VAULT_ROOT=
MAILBUS_SKILLS_ROOT=
MAILBUS_RULES_ROOT=
MAILBUS_PLANS_ROOT=
MAILBUS_DOCS_ROOT=
MAILBUS_IDENTITIES_ROOT=
