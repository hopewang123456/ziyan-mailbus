<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.hopewang123456</groupId>
  <artifactId>mailbus-j</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>mailbus-j</name>
  <description>mailbus Java implementation — file-based A2A message bus (monorepo java/ subtree)</description>

  <!--
    P0a 塑形基线（2026-10-26，规划文档 D12/D9）：JDK 25 LTS + Spring Boot 4.1.x +
    Spring AI 2.0.x（BOM 锁版）+ 官方 a2a-java SDK（AA1，先锁版本后集成）。
    一律 GA 版本，无 milestone/repo 例外。分层由 ArchUnit 在 mailbus-boot tests 守卫。
  -->

  <modules>
    <module>mailbus-domain</module>
    <module>mailbus-ports</module>
    <module>mailbus-app</module>
    <module>mailbus-adapters</module>
    <module>mailbus-infra</module>
    <module>mailbus-api</module>
    <module>mailbus-cli</module>
    <module>mailbus-boot</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.1.2</spring-boot.version>
    <spring-ai.version>2.0.2</spring-ai.version>
    <a2a-sdk.version>1.4.0.Final</a2a-sdk.version>
    <picocli.version>4.7.6</picocli.version>
    <archunit.version>1.5.1</archunit.version>
    <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring AI 2.0 GA：要求 Boot 4.x / Framework 7（D10 智能层地基） -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 官方 A2A Java SDK（AA1 / M2d-b）：BOM 统一管 SDK 全工件版本 -->
      <dependency>
        <groupId>org.a2aproject.sdk</groupId>
        <artifactId>a2a-java-sdk-bom</artifactId>
        <version>${a2a-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- picocli core only: no Boot 4 starter exists upstream (issue #2491);
           Spring wiring is a thin local IFactory in mailbus-boot (P0a). -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <!-- in-repo modules -->
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-ports</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-app</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-adapters</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-infra</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.github.hopewang123456</groupId><artifactId>mailbus-cli</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <parameters>true</parameters>  <!-- Spring MVC @PathVariable/@RequestParam name resolution -->
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
