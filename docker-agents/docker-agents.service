[Unit]
Description=Mailbus Docker Agent 容器
After=docker.service network-online.target
Wants=docker.service network-online.target
# 不用 Requires=docker.service —— Docker 重启时不应触发 compose down 停掉全部容器

[Service]
Type=oneshot
RemainAfterExit=yes
User=@MAILBUS_USER@
WorkingDirectory=@MAILBUS_ROOT@/docker-agents

EnvironmentFile=-@MAILBUS_ROOT@/docker-agents/.env
Environment=MAILBUS_ROOT=@MAILBUS_ROOT@

ExecStartPre=/usr/bin/python3 @MAILBUS_ROOT@/tools/mailbus.py proxy setup
ExecStart=/usr/bin/docker compose -f @MAILBUS_ROOT@/docker-agents/docker-compose.yml up -d --remove-orphans
# 禁止 ExecStop 执行 compose down（这是 mailbus 断线的根因之一）
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
