# ComfyUI + n8n 本地栈
#
# mailbus 运行时（跨 OS，与 ComfyUI 安装位置解耦）：
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# 远程 Linux 示例：COMFYUI_BASE_URL=http://gpu-server:8188
#
# 仅 ensure-comfyui / Windows 原生安装：
# COMFYUI_WORKSPACE=E:/ai_tools/ComfyUI-win
# COMFYUI_PORT=8188
# 模型下载镜像（国内可选 hf-mirror）
# COMFYUI_CKPT_URL=https://hf-mirror.com/Comfy-Org/stable-diffusion-v1-5-archive/resolve/main/v1-5-pruned-emaonly.safetensors

# n8n（wsl bash docker-agents/start-n8n.sh 后；Windows 跑 tools/sync-n8n-url.ps1 自动写 WSL IP）
N8N_PUBLISH_WEBHOOK_URL=http://127.0.0.1:5678/webhook/mailbus-multi-publish
# 可选 webhook 生图（mailbus 默认直连 ComfyUI，不必经 n8n）
# IMAGE_GENERATE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/mailbus-image-generate
