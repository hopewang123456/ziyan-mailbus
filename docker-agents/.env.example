# ============================================================
# 子言·AI 团队 — Docker 容器化环境变量
# 复制为 .env 并填入你的 API Key
# ============================================================

# DeepSeek API（主模型 / mailbus remote LLM fallback）
OPENAI_API_KEY=sk-your-key-here
MAILBUS_INTERNAL_LLM_API_KEY=sk-your-deepseek-key-here

# Ollama（Windows 原生 / Docker 用 host.docker.internal）
MAILBUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
MAILBUS_OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# 生图（ComfyUI — Windows 跑 mailbus 时用 sync-comfyui-url.ps1 写 WSL IP）
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# 生图 webhook（video_publish image-generate 步，tool_live 时生效）
IMAGE_GENERATE_WEBHOOK_URL=https://your-image-api.example/generate

# 时区
TZ=Asia/Shanghai

# Docker Compose 项目名称
COMPOSE_PROJECT_NAME=ziyan-team
