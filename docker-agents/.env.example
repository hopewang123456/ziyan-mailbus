# docker-agents/.env — compose variable sample (copy to .env in this directory)
#   cp .env.example .env
#
# Decoupling: set framework home dirs to ABSOLUTE paths (may point at your Agent
# trees) = config association. Leave empty to fall back to ./workspaces/* placeholders.
# Do NOT use relative ../../Agent/docker or ../openclaw_space.
# Never commit a real .env. Repo-root .env: see ../migrate/env.template and ../config/env.template.

# -- Host root for override.yml (path as Docker/WSL sees it) -----------------
# Windows e.g. E:/ai_tools/mailbus
# WSL e.g.     /mnt/e/ai_tools/mailbus
MAILBUS_HOST_ROOT=

# -- Framework workspaces (absolute paths) -----------------------------------
HERMES_DATA=
OPENCLAW_WORKSPACE=
CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
CODEX_SKILLS=
OPENCODE_ROOT=
DSH_WORKSPACE=
NODE_MODULES=

# -- Secrets / tokens (never use change-me; leave OpenClaw empty if unused) --
DEEPSEEK_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
MAILBUS_API_TOKEN=

# -- Compose / API -----------------------------------------------------------
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
OPENCLAW_VERSION=
DSH_VERSION=

# Optional container egress proxy
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=

# -- Optional toggles --------------------------------------------------------
RESET_OPENCLAW_PAIRING=0
FORCE_RENDER_CODEX_CONFIG=0
DSH_WEB_ENABLED=1
