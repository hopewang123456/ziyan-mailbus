# Copy to docker-agents/.env (gitignored). Compose substitutes these for volumes.
#
# Decoupling: set absolute paths to YOUR agent runtimes (anywhere on disk).
# Do NOT junction/copy Agent trees into docker-agents/workspaces/ — that directory
# is only an empty fallback when a variable is unset.

MAILBUS_HOST_ROOT=

# Explicit association (examples — replace with your hosts):
# OPENCLAW_WORKSPACE=/mnt/e/path/to/openclaw_space
# CODEX_WORKSPACE=/mnt/e/path/to/codex
OPENCLAW_WORKSPACE=
CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
OPENCODE_ROOT=
DSH_WORKSPACE=
HERMES_DATA=

OPENCLAW_GATEWAY_TOKEN=
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
