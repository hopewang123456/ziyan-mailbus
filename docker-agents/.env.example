# Copy to docker-agents/.env (gitignored). Used by docker compose for volume substitution.
# Prefer these vars over absolute paths inside docker-compose.override.yml.

# Host path to this mailbus repo as seen by the Docker engine
# WSL Docker example: /mnt/e/ai_tools/mailbus
# Native Linux: /home/you/mailbus
MAILBUS_HOST_ROOT=

# Framework workspaces (empty → docker-compose.yml falls back to ./workspaces/*)
HERMES_DATA=
OPENCLAW_WORKSPACE=
CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
OPENCODE_ROOT=
DSH_WORKSPACE=

OPENCLAW_GATEWAY_TOKEN=
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
