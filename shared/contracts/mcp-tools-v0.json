{
  "version": "1.0.0",
  "description": "mailbus MCP 工具面契约（唯一 SoT）。已按 docs/design/agent-unification-design.md §11.3 收敛为 4 个工具；工作流由引擎驱动，Agent 不得自建任务或推进状态机。旧的 task_create/task_fsm/step_result 等工具已移除，调用应返回 404。",
  "identity": {
    "note": "身份由接入会话确定，入参不得跨身份伪造。inbox/send 使用员工能力会话（Bearer 会话 token，需 message:send 能力）；ack/result 使用 Agent endpoint token（/api/a2a/messages），身份由 token 反查。",
    "from_parameter": "from"
  },
  "tools": [
    {
      "name": "mailbus_inbox",
      "title": "拉取待办",
      "group": "message",
      "transport": "http",
      "auth": "employee_session",
      "http": {"method": "GET", "path": "/api/mcp/pull"},
      "description": "拉取当前接入身份对应员工的待办事件队列（drain 语义：取走即清空）。",
      "input": {"type": "object", "properties": {}},
      "returns": "[{event_id, kind, payload, attempts}]"
    },
    {
      "name": "mailbus_send",
      "title": "发送消息",
      "group": "message",
      "transport": "http",
      "auth": "employee_session",
      "http": {"method": "POST", "path": "/api/mcp/messages"},
      "description": "向指定员工投递消息；发送方取当前接入身份，不得伪造 from。",
      "input": {
        "type": "object",
        "properties": {
          "recipient_id": {"type": "string", "description": "收件员工 id（字符集 [A-Za-z0-9_-]）"},
          "body": {"type": "string", "description": "消息正文，1-4000 字"},
          "kind": {"type": "string", "default": "note", "description": "消息类型"}
        },
        "required": ["body"]
      },
      "returns": "{message_id, sender_id, recipient_id, kind, body, created_at, delivery_status}"
    },
    {
      "name": "mailbus_ack",
      "title": "确认受理",
      "group": "task",
      "transport": "a2a",
      "auth": "agent_token",
      "http": {"method": "POST", "path": "/api/a2a/messages"},
      "description": "确认受理一条 task_assignment（payload.type=ack）。收到投递后应尽快调用。",
      "input": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "const": "ack"},
          "message_id": {"type": "string", "description": "被确认的投递 message_id"}
        },
        "required": ["message_id"]
      },
      "returns": "{message_id, accepted, duplicate}"
    },
    {
      "name": "mailbus_result",
      "title": "回推节点结果",
      "group": "task",
      "transport": "a2a",
      "auth": "agent_token",
      "http": {"method": "POST", "path": "/api/a2a/messages"},
      "description": "回推节点执行结果（payload.type=result）；run_id 与 attempt_no 必填，旧 attempt 返回 409。",
      "input": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "const": "result"},
          "run_id": {"type": "string"},
          "attempt_no": {"type": "integer", "minimum": 1},
          "status": {
            "type": "string",
            "enum": ["completed", "failed", "needs_human", "needs_info", "rejected"]
          },
          "output": {"type": "string", "description": "结果文本或可解析的 JSON 字符串"},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {"type": "string", "enum": ["path", "artifact"]},
                "file_path": {"type": "string"},
                "artifact_id": {"type": "string"},
                "file_name": {"type": "string"},
                "description": {"type": "string"}
              },
              "required": ["type"]
            }
          },
          "completed_at": {"type": "string", "format": "date-time"}
        },
        "required": ["run_id", "attempt_no", "status"]
      },
      "returns": "{message_id, accepted, duplicate}"
    }
  ]
}
