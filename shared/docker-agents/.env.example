# docker-agents/.env sample — copy to .env
# cp .env.example .env
# Absolute paths only for framework homes; empty = ./workspaces/* fallback.
# Do not commit a real .env. See also ../migrate/env.template

MAILBUS_HOST_ROOT=

HERMES_DATA=
OPENCLAW_WORKSPACE=
CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
CODEX_SKILLS=
OPENCODE_ROOT=
DSH_WORKSPACE=
NODE_MODULES=

DEEPSEEK_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
MAILBUS_API_TOKEN=

MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents
OPENCLAW_VERSION=
DSH_VERSION=

CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=

RESET_OPENCLAW_PAIRING=0
FORCE_RENDER_CODEX_CONFIG=0
DSH_WEB_ENABLED=1

# 构建镜像源（可选）：npmjs 直连被 DNS 污染时必配，apt 换国内源加速
# 对应各 Dockerfile 的 ARG npm_config_registry / hermes 的 ARG APT_MIRROR（裸 host，不带 scheme）
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.aliyun.com
# DeepSeek 云 API key：cline(lingxing) 推送与 codex 网关共用
DEEPSEEK_API_KEY=
