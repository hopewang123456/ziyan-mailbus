      },
      {
        "framework": "claude_code",
        "native": "%USERPROFILE%/.claude-agent-b/skills",
        "target": "03-shared/claude/skills",
        "ids": ["agent-b"]
      },
      {
        "framework": "claude_code",
        "native": "%USERPROFILE%/.claude-agent-c/skills",
        "target": "03-shared/claude/skills",
        "ids": ["agent-c"]
      },
      {
        "framework": "opencode",
        "native": "<OPENCODE_ROOT>/skills",
