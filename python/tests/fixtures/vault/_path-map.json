{
  "vault_root": "fixtures",
  "roots": {
    "agent_root": "Agent",
    "members_root": "Agent/02-members"
  },
  "persons": {
    "agent-a": {"dir": "022131-agent-a", "id": "022131"},
    "agent-b": {"dir": "022132-agent-b", "id": "022132"},
    "agent-c": {"dir": "022133-agent-c", "id": "022133"},
    "agent-d": {"dir": "022631-agent-d", "id": "022631"}
  },
  "frameworks": {
