# Mailbus environment — copy to mailbus/.env and edit paths
MAILBUS_ROOT=/path/to/mailbus
MAILBUS_DATA=/path/to/mailbus/store
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents

# Infrastructure (optional — set via settings or here; empty = not configured)
OPENCLAW_WORKSPACE=
OPENCLAW_CONFIG=
MAILBUS_DISCOVERY_DIRS=
OPENCODE_ROOT=
NODE_MODULES=
HERMES_DATA=
TEAM_PACK_ROOT=/path/to/mailbus/team-pack

# docker-agents/.env (compose project dir) — host path as Docker engine sees it
# MAILBUS_HOST_ROOT=/mnt/<drive>/path/to/mailbus

CODEX_WORKSPACE=
CODEX_REVIEW_WORKSPACE=
CODEX_SKILLS=
DSH_WORKSPACE=
CODEX_SKILLS=

# Skills / rules / identities (OPTIONAL)
# Default = repo skills/ | rules/ | identities/ (examples committed to git).
# Prefer Dashboard「资产路径」custom paths over editing these.
# MAILBUS_SKILLS_ROOT=./skills
# MAILBUS_RULES_ROOT=./rules
# MAILBUS_IDENTITIES_ROOT=./identities
# MAILBUS_DOCS_ROOT=./docs
# MAILBUS_PLANS_ROOT=./plans

# External agent skills/memory for Dashboard profile cards:
# configure in store/config.json → agents.<id>.profile_paths.skills_dirs / memory_dir
# (see examples/config.example.json).
