# Mailbus environment — copy to mail/.env and edit paths
MAILBUS_ROOT=/path/to/mail
MAILBUS_DATA=/path/to/mail/store
MAILBUS_API_PORT=9814
COMPOSE_PROJECT_NAME=docker-agents

# Infrastructure (optional — set if you use these agents/services)
OPENCLAW_WORKSPACE=/path/to/openclaw_space
OPENCODE_ROOT=/path/to/opencode
NODE_MODULES=/path/to/node_modules
HERMES_DATA=/path/to/hermes-data/.hermes
TEAM_PACK_ROOT=/path/to/team-pack

# Agent workspaces (optional — or set in access/transport/*/transport.json)
CODEX_WORKSPACE=/path/to/codex
CODEX_REVIEW_WORKSPACE=/path/to/codex-review
CODEX_SKILLS=/path/to/.codex/skills

# Skills / rules knowledge roots (OPTIONAL — CI/publish only)
# Leave unset to use repo-relative mail/skills|rules|... (or host junctions).
# Do NOT point these at Obsidian Vault on local Windows; use junctions +
# docker-agents/docker-compose.override.yml instead (see override.example.yml).
# MAILBUS_SKILLS_ROOT=./skills
# MAILBUS_RULES_ROOT=./rules
# MAILBUS_DOCS_ROOT=./docs
# MAILBUS_PLANS_ROOT=./plans
# TEAM_PACK_SKILLS_ROOT=../team-pack/skills
# TEAM_PACK_RULES_ROOT=../team-pack/rules

# External agent skills/memory for Dashboard profile cards:
# configure in store/config.json → agents.<id>.profile_paths.skills_dirs / memory_dir
# (see examples/config.example.json). Empty = each runtime's default skills/memory.
